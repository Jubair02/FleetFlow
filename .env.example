# Copy to .env and fill in. Never commit .env.

# Database (Neon). The app uses the POOLED url; `prisma migrate` needs the
# DIRECT (non-pooled) one — on Neon, the same url without "-pooler" in the host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Public base URL used in emailed links (tracking pages, sign-in, "forgot password").
# Required in production (the server refuses to start without it, unless
# Vercel provides its production domain).
APP_URL="http://localhost:3000"

# Proof-of-delivery file storage. When set, files go to Cloudinary as private
# assets (required on Vercel). Unset = local disk (storage/pod), dev only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Error monitoring (Sentry). Empty = off. The DSN is not a secret.
NEXT_PUBLIC_SENTRY_DSN=""
# Build-time only, for uploading source maps (CI / Vercel). Keep secret.
SENTRY_AUTH_TOKEN=""

# Self-hosting behind a reverse proxy: how many proxies append to
# X-Forwarded-For (used for rate limiting). Ignored on Vercel.
TRUSTED_PROXY_HOPS="1"

# Email: "resend" sends real email via the Resend HTTP API; "console" (default)
# only records/logs emails as SIMULATED — nothing leaves the server.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="FleetFlow <notifications@your-domain.com>"

# Self-service company sign-up on the login page ("false" = invite-only).
ALLOW_SIGNUP="true"

# Show one-click demo accounts on the login page. Keep "false" anywhere real data lives.
NEXT_PUBLIC_DEMO_MODE="false"

# SMS: "bulksmsbd" texts customers via BulkSMSBD; "console" (default) only records them as SIMULATED.
SMS_PROVIDER=""
# BulkSMSBD API key (required for SMS_PROVIDER=bulksmsbd). Keep secret.
BULKSMSBD_API_KEY=""
# BulkSMSBD approved sender id (required for SMS_PROVIDER=bulksmsbd).
BULKSMSBD_SENDER_ID=""

# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token). Unset = cron routes return 503.
CRON_SECRET=""

# Billing (src/lib/payments): how companies pay invoices. "manual" (default) shows the
# accounts below with the invoice number as reference; FleetFlow staff verify payments
# and mark invoices paid in /platform. Unknown values fall back to manual.
PAYMENT_PROVIDER="manual"
PAYMENT_BKASH_NUMBER=""
PAYMENT_NAGAD_NUMBER=""
PAYMENT_ROCKET_NUMBER=""
# Free text; write \n for a new line, e.g. "Acme Bank, Gulshan branch\nA/C name: FleetFlow Ltd\nA/C no: 123…"
PAYMENT_BANK_DETAILS=""
# Where "payment reported" alerts go (FleetFlow billing inbox). Unset = only logged; the
# console's Overview → Payments to verify list is always up to date.
BILLING_NOTIFY_EMAIL=""

# Maps (docs/MAPS.md) — Barikoi, Bangladesh. Both optional: without them addresses aren't
# looked up and maps use OpenStreetMap tiles (fine for development, not for production traffic).
# BARIKOI_API_KEY: server only — geocoding, the pin picker's address search.
# BARIKOI_MAP_KEY: map tiles in the browser (visible to visitors). Falls back to BARIKOI_API_KEY;
# use a separate key restricted to your domain in Barikoi's dashboard.
BARIKOI_API_KEY=""
BARIKOI_MAP_KEY=""
