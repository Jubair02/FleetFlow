generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled — used by the app at runtime
  directUrl = env("DIRECT_URL") // non-pooled — used by prisma migrate
}

// ─────────────────────────────────────────────────────────────
// FleetFlow schema — multi-tenant, org-scoped, auditable
// ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("trial") // Plan.code (FK) — plans are managed in the platform console
  planRecord Plan    @relation(fields: [plan], references: [code], onUpdate: Cascade, onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Company profile & settings (onboarding)
  phone                 String?
  contactEmail          String?
  address               String?
  defaultPickupAddress  String?
  timezone              String    @default("Asia/Dhaka")
  onboardingDismissedAt DateTime?

  // Platform account status (managed by FleetFlow super admins only).
  // SUSPENDED blocks sign-in and API use for the company's staff and drivers;
  // no data is deleted. Public tracking links keep working.
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED
  suspendedAt     DateTime?
  suspendedReason String?

  // Subscription bookkeeping, recorded MANUALLY (no payment integration).
  subscriptionStatus String    @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | CANCELLED
  paidUntil          DateTime?
  billingNotes       String?
  // Price snapshot taken when the plan was assigned: later plan price changes
  // don't alter what an existing subscriber pays (grandfathering).
  billingCycle         String    @default("MONTHLY") // MONTHLY | ANNUAL
  subscriptionPriceBdt Int? // agreed price per billing cycle; null = free (trial)
  planAssignedAt       DateTime  @default(now())

  users         User[]
  vehicles      Vehicle[]
  deliveries    Delivery[]
  auditLogs     AuditLog[]
  notifications Notification[]
  importBatches ImportBatch[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String       @unique
  passwordHash   String
  role           String // ADMIN | DRIVER
  active         Boolean      @default(true)
  mustChangePassword Boolean  @default(false) // set when an admin creates/resets the password
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  driverProfile DriverProfile?
  sessions      Session[]
  notifications Notification[]
  assignments   Assignment[]      @relation("DriverAssignments")
  events        DeliveryEvent[]   @relation("EventActor")
  pods          ProofOfDelivery[] @relation("PodUploader")

  @@index([organizationId, role])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Failure counters for login / sign-up / password throttling (src/lib/rate-limit.ts).
// Shared by every server instance; rows expire with their window.
model RateLimit {
  key     String   @id // e.g. "email:ann@example.com", "ip:203.0.113.7", "signup:203.0.113.7"
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model DriverProfile {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone         String
  licenseNumber String
  availability  String @default("AVAILABLE") // AVAILABLE | ON_ROUTE | OFF_DUTY
  maxActiveJobs Int    @default(3)
}

model Vehicle {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  registrationNumber String
  type               String // VAN | BOX_TRUCK | MOTORCYCLE | CAR | REFRIGERATED
  capacity           String? // human readable, e.g. "3.5 t / 12 m³"
  status             String       @default("ACTIVE") // ACTIVE | MAINTENANCE | INACTIVE
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  assignments Assignment[]

  @@unique([organizationId, registrationNumber])
  @@index([organizationId, status])
}

model Delivery {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  trackingCode    String       @unique
  trackingToken   String       @unique
  trackingEnabled Boolean      @default(true)
  recipientName   String
  recipientPhone  String
  pickupAddress   String
  deliveryAddress String
  instructions    String?
  externalRef     String? // the business's own order/invoice number (CSV import duplicate check)
  recipientEmail  String? // optional: customer gets the tracking link by email
  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id])
  priority        String       @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status          String       @default("CREATED") // CREATED | ASSIGNED | PICKED_UP | IN_TRANSIT | DELIVERED | FAILED | CANCELLED
  expectedAt      DateTime?
  failureReason   String?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  assignments Assignment[]
  events      DeliveryEvent[]
  pods        ProofOfDelivery[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, expectedAt])
  @@index([organizationId, externalRef])
}

model Assignment {
  id           String    @id @default(cuid())
  deliveryId   String
  delivery     Delivery  @relation(fields: [deliveryId], references: [id])
  driverId     String
  driver       User      @relation("DriverAssignments", fields: [driverId], references: [id])
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  completedAt  DateTime?
  active       Boolean   @default(true)
  outcome      String? // set when closed: DELIVERED | FAILED | CANCELLED | UNASSIGNED

  @@index([driverId, active])
  @@index([vehicleId, active])
  @@index([deliveryId, active])
}

// Append-only history — never update or delete rows here.
model DeliveryEvent {
  id        String   @id @default(cuid())
  deliveryId String
  delivery  Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("EventActor", fields: [actorId], references: [id])
  actorName String?
  eventType String // CREATED | ASSIGNED | UNASSIGNED | PICKED_UP | IN_TRANSIT | DELIVERED | FAILED | NOTE | CANCELLED | TRACKING_UPDATED | OVERRIDE
  note      String?
  customerVisible Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([deliveryId, createdAt])
}

model ProofOfDelivery {
  id            String   @id @default(cuid())
  deliveryId    String
  delivery      Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  fileKey       String // storage-relative path, file lives on disk — never in DB
  fileName      String
  mimeType      String
  kind          String // SIGNATURE | PHOTO
  recipientName String
  capturedAt    DateTime @default(now())
  uploadedById  String?
  uploadedBy    User?    @relation("PodUploader", fields: [uploadedById], references: [id])

  @@index([deliveryId])
}

model Notification {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userId         String? // null for emails to people without an account (e.g. delivery recipients)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // NEW_ASSIGNMENT | UNASSIGNED | PICKED_UP | IN_TRANSIT | DELIVERED | FAILED | POD_UPLOADED | TRACKING
  channel        String        @default("IN_APP") // IN_APP | EMAIL
  title          String
  body           String
  recipientEmail String? // used for EMAIL channel
  deliveryId     String?
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  // Email delivery state (channel=EMAIL): PENDING | SENDING | SENT | FAILED | SIMULATED
  status            String?
  attempts          Int       @default(0)
  sentAt            DateTime?
  lastError         String?
  providerMessageId String?
  dedupeKey         String?   @unique // prevents duplicate sends for the same event

  @@index([userId, channel, readAt])
  @@index([organizationId, channel, createdAt])
}

// One row per committed CSV import; fileHash blocks importing the same file twice.
model ImportBatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fileName       String
  fileHash       String
  source         String       @default("CSV") // CSV | PASTE
  // Client-generated key per commit request: a retried request returns the
  // original result instead of importing twice.
  idempotencyKey String?
  rowCount       Int
  importedCount  Int
  skippedCount   Int
  failedCount    Int
  createdById    String?
  createdByName  String?
  createdAt      DateTime     @default(now())

  deliveries Delivery[]

  @@unique([organizationId, fileHash])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String?
  actorName      String?
  action         String // DELIVERY_CREATED | DRIVER_ASSIGNED | STATUS_OVERRIDE | ...
  entityType     String
  entityId       String
  detail         String? // JSON string
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Platform (super admin) — deliberately separate from tenant users.
// No User field grants platform access; platform admins are created
// only by scripts/create-super-admin.mjs (no public registration).
// ─────────────────────────────────────────────────────────────

model PlatformAdmin {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions PlatformSession[]
}

model PlatformSession {
  id        String        @id @default(cuid())
  token     String        @unique // SHA-256 of the cookie token
  adminId   String
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([adminId])
}

// Append-only log of super admin actions (never passwords/tokens).
model PlatformAuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorName      String?
  action         String // ORG_CREATED | ORG_SUSPENDED | ORG_REACTIVATED | PLAN_CHANGED | SUBSCRIPTION_UPDATED | USER_* | PLATFORM_LOGIN | ...
  organizationId String?
  targetType     String // Organization | User | PlatformAdmin
  targetId       String?
  detail         String? // JSON, safe metadata only
  ip             String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([organizationId, createdAt])
}

// Subscription plan, editable by platform admins. Organization.plan references
// Plan.code. Plans are never deleted (only deactivated) and codes are immutable.
// Limits apply live to every subscriber; prices are snapshotted per organization.
model Plan {
  code                 String   @id // lowercase slug, e.g. "growth"
  name                 String
  description          String?
  monthlyPriceBdt      Int? // null = not sold monthly (e.g. trial)
  annualPriceBdt       Int? // null = no annual option
  maxDrivers           Int? // null = unlimited
  maxVehicles          Int?
  maxAdmins            Int?
  maxMonthlyDeliveries Int?
  features             String[] // feature keys — see src/lib/plan-catalog.ts FEATURES
  highlights           String[] // marketing bullets shown on pricing cards
  active               Boolean  @default(true) // inactive: can't be newly assigned; subscribers keep it
  isPublic             Boolean  @default(true) // shown on the public pricing table
  isDefault            Boolean  @default(false) // plan given to self-service sign-ups (exactly one)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organizations Organization[]
}
